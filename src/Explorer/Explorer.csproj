<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>whatsapp-archive-explorer</AssemblyName>
    <RootNamespace>ArchiveExplorer</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No user secrets, no launch profiles: a portable tool. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- dotnet publish -r <rid> -c Release → one self-contained executable (no .NET install needed). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.74" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Explorer.Tests" />
  </ItemGroup>

  <!-- The web UI (Next.js static export) is built and embedded as resources "ui/<path>".
       dotnet build -p:SkipWeb=true skips it (the server then shows a short notice instead of the UI). -->
  <PropertyGroup>
    <WebDir>$(MSBuildThisFileDirectory)..\web\</WebDir>
  </PropertyGroup>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(SkipWeb)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" EnvironmentVariables="NEXT_TELEMETRY_DISABLED=1" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" EnvironmentVariables="NEXT_TELEMETRY_DISABLED=1" />
    <ItemGroup>
      <WebOut Include="$(WebDir)out\**\*" />
      <EmbeddedResource Include="@(WebOut)" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
